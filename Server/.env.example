PORT=8000
MISTRAL_API_KEY=your_mistral_api_key
GROQ_API_KEY=your_groq_api_key

# Auth
JWT_SECRET=any_long_random_string_here

# ─── Email via Brevo (https://app.brevo.com) ──────────────────────────────────
# Free tier: 300 emails/day, sends to ANY email address, no domain needed.
# SMTP port 587 (STARTTLS) — works on Render, Railway, Fly.io without issues.
#
# How to get these:
#   1. Sign up free at https://app.brevo.com
#   2. Go to Account → SMTP & API → SMTP tab
#   3. Copy the Login and Master Password shown there
#
BREVO_USER=your_brevo_login_email@gmail.com
BREVO_PASS=your_brevo_smtp_master_password

# The "from" display name and address shown in emails
SMTP_FROM="BREAKOUT" <your_brevo_login_email@gmail.com>

# Frontend URL — used to build email verification links
# Local dev: http://localhost:5173
# Production: your Vercel URL e.g. https://breakout.vercel.app
CLIENT_URL=http://localhost:5173
